# Server
PORT=3001
NODE_ENV=development
# One origin, or a comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
# Public URL of this backend, used for Twilio webhooks (Railway sets RAILWAY_PUBLIC_DOMAIN automatically)
BACKEND_URL=http://localhost:3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional: anon key used to verify user JWTs (falls back to the service role key)
SUPABASE_ANON_KEY=your_anon_key_here

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Calendar OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:3001/api/businesses/calendar/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_SOLO_PRICE_ID=price_xxxx

# Encryption key for Google tokens and OAuth state (32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_string_here
